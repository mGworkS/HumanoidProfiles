{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "robot_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "array",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "belegt",
              "eingeschraenkt",
              "angekuendigt",
              "widerspruechlich",
              "unbekannt",
              "nicht_anwendbar",
              "nicht_veroeffentlicht"
            ]
          },
          "evidence": {
            "enum": [
              "herstellerangabe",
              "herstellerdemo",
              "unabhaengiger_test",
              "kundenbericht",
              "eigener_test",
              "redaktionelle_einordnung",
              "keine",
              "projektkatalog"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "locator"
              ],
              "additionalProperties": false
            },
            "uniqueItems": true
          },
          "context": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "checked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "valid_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "valid_until": {
            "type": [
              "string",
              "null"
            ]
          },
          "supersedes": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "key",
          "value",
          "unit",
          "status",
          "evidence",
          "sources",
          "context",
          "checked_at",
          "valid_from",
          "valid_until",
          "supersedes"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "unbekannt",
                    "nicht_anwendbar",
                    "nicht_veroeffentlicht"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "value": {
                  "not": {
                    "type": "null"
                  }
                },
                "sources": {
                  "minItems": 1
                },
                "checked_at": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        ]
      },
      "uniqueItems": true
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "provider_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "mode": {
            "enum": [
              "kauf",
              "miete",
              "leasing",
              "raas",
              "pilot",
              "forschungskooperation",
              "leihstellung",
              "unbekannt"
            ]
          },
          "status": {
            "enum": [
              "bestaetigt",
              "angekuendigt",
              "beendet",
              "unbekannt"
            ]
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "audiences": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "price": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "billing": {
            "enum": [
              "einmalig",
              "monatlich",
              "jaehrlich",
              "betriebsstunde",
              "aufgabe",
              "ergebnis",
              "unbekannt"
            ]
          },
          "subscription": {
            "enum": [
              "verpflichtend",
              "optional",
              "nicht_erforderlich",
              "unbekannt"
            ]
          },
          "term": {
            "type": [
              "string",
              "null"
            ]
          },
          "included": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "exit_conditions": {
            "type": [
              "string",
              "null"
            ]
          },
          "configuration": {
            "type": "string",
            "minLength": 1
          },
          "checked_at": {
            "type": "string",
            "format": "date"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "provider_id",
          "mode",
          "status",
          "regions",
          "audiences",
          "price",
          "currency",
          "billing",
          "subscription",
          "term",
          "included",
          "exit_conditions",
          "configuration",
          "checked_at",
          "source_ids"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}(-([0-9]{2})(-[0-9]{2})?|-H[12])?$"
          },
          "status": {
            "enum": [
              "bestaetigt",
              "angekuendigt",
              "widerspruechlich"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "type",
          "date",
          "status",
          "description",
          "source_ids"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "claim_ids"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": {
            "enum": [
              "foto",
              "rendering",
              "video",
              "datenblatt",
              "handbuch",
              "logo",
              "zeichnung"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "local_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "rights": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "type",
          "url",
          "local_path",
          "source_id",
          "rights",
          "version",
          "language",
          "sha256",
          "scope"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "robot_id",
    "claims",
    "offers",
    "events",
    "extensions",
    "media"
  ],
  "additionalProperties": false
}
